{
  "name": "list_requests",
  "description": "List cached request status only; never creates, updates, or submits a request.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "term": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "forceRefresh": {
        "type": "boolean",
        "description": "Queue a metadata-only refresh while returning the last good cache."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
