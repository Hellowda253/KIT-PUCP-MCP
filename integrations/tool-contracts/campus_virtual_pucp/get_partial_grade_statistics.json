{
  "name": "get_partial_grade_statistics",
  "description": "Fetch or return cached institutional Campus statistics for one partial assessment, including mean, median, deviation, pass rates, and distribution.",
  "parameters": {
    "type": "object",
    "properties": {
      "course": {
        "type": "string",
        "minLength": 1
      },
      "term": {
        "type": "string",
        "pattern": "^\\d{4}-\\d+$"
      },
      "evaluationType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "evaluationNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99
      },
      "schedule": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
      },
      "forceRefresh": {
        "type": "boolean",
        "description": "Queue a metadata-only refresh while returning the last good cache."
      }
    },
    "required": [
      "course",
      "term",
      "evaluationType",
      "evaluationNumber"
    ],
    "additionalProperties": false
  }
}
