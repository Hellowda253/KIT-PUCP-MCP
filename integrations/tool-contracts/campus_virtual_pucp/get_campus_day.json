{
  "name": "get_campus_day",
  "description": "Return cached Campus agenda events for one YYYY-MM-DD date.",
  "parameters": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "course": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "forceRefresh": {
        "type": "boolean",
        "description": "Queue a metadata-only refresh while returning the last good cache."
      }
    },
    "required": [
      "date"
    ],
    "additionalProperties": false
  }
}
