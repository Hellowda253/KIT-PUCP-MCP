{
  "name": "list_upcoming_academic_items",
  "description": "List upcoming cached Campus events and Paideia due items in chronological order.",
  "parameters": {
    "type": "object",
    "properties": {
      "start": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "end": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "course": {
        "type": "string"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
